---
import AppLayout from '../../../layouts/AppLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ProjectTabs from '../../../components/ProjectTabs.astro';
import PlannedFeature from '../../../components/PlannedFeature.astro';
import { getProjectOverview } from '../../../lib/server/queries';

const supabase = Astro.locals.supabase!;
const project = await getProjectOverview(supabase, Astro.params.id!);
if (!project) {
  return Astro.redirect('/projects');
}
---

<AppLayout title={`${project.title} — Dosszié`}>
  <PageHeader
    eyebrow={project.client?.display_name ?? 'Projekt'}
    title={project.title}
  />
  <ProjectTabs projectId={project.id} active="resources" />
  <PlannedFeature
    wave="W3"
    title="Projektdosszié"
    description="Ide kerülnek a projekthez csatolt linkek, privát fájlok és jegyzetek — kategorizálva, kereshetően. A fájlfeltöltés privát Supabase Storage-bucketbe történik majd."
  />
</AppLayout>
