---
import AppLayout from '../../../layouts/AppLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ProjectTabs from '../../../components/ProjectTabs.astro';
import PlannedFeature from '../../../components/PlannedFeature.astro';
import { getProjectOverview } from '../../../lib/server/queries';

const supabase = Astro.locals.supabase!;
const project = await getProjectOverview(supabase, Astro.params.id!);
if (!project) {
  return Astro.redirect('/projects');
}
---

<AppLayout title={`${project.title} — Átadás`}>
  <PageHeader
    eyebrow={project.client?.display_name ?? 'Projekt'}
    title={project.title}
  />
  <ProjectTabs projectId={project.id} active="handover" />
  <PlannedFeature
    wave="W4"
    title="Átadás és lezárás"
    description="Záró összefoglaló, számla- és visszajelzés-hivatkozások, nyitott tételek és nyomtatóbarát/Markdown export. A nem ellenőrzött vagy sikertelen QA-pontok itt sem jelennek meg teljesítésként."
  />
</AppLayout>
