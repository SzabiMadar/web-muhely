---
import AppLayout from '../../../layouts/AppLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ProjectTabs from '../../../components/ProjectTabs.astro';
import PlannedFeature from '../../../components/PlannedFeature.astro';
import { getProjectOverview } from '../../../lib/server/queries';

const supabase = Astro.locals.supabase!;
const project = await getProjectOverview(supabase, Astro.params.id!);
if (!project) {
  return Astro.redirect('/projects');
}
---

<AppLayout title={`${project.title} — Hozzáférések`}>
  <PageHeader
    eyebrow={project.client?.display_name ?? 'Projekt'}
    title={project.title}
  />
  <ProjectTabs projectId={project.id} active="access" />
  <PlannedFeature
    wave="W3"
    title="Hozzáférési térkép"
    description="Szolgáltatások, URL-ek, fióknevek és jelszókezelő-hivatkozások nyilvántartása — jelszó és token mező nélkül. A Műhely soha nem tárol titkot, csak külső jelszókezelő rekordok referenciáit."
  />
</AppLayout>
