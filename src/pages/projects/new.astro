---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
---

<AppLayout title="Új projekt">
  <PageHeader
    eyebrow="Projektek / Új projekt"
    title="Új projekt felvétele"
    description="A projektlétrehozó űrlap a W1 fejlesztési szeletben készül el, az adatbázis-kapcsolattal együtt."
  />

  <section class="card planned">
    <div class="panel-head">
      <h2>Így fog működni</h2>
      <StatusPill variant="warning" label="W1 szeletben érkezik" />
    </div>
    <ul class="planned-list">
      <li><strong>Ügyfél:</strong> meglévő ügyfél kiválasztása vagy új gyorsfelvétel anélkül, hogy elnavigálnál.</li>
      <li><strong>Alapadatok:</strong> projektnév, munkatípus — új weboldal, felújítás vagy kisebb fejlesztés.</li>
      <li><strong>Scope:</strong> rövid leírás és opcionális határidő.</li>
      <li><strong>Létrehozáskor:</strong> a 11 fázis állapota és a munkatípushoz tartozó feladatlista automatikusan elkészül.</li>
    </ul>
    <p class="planned-foot">
      <a class="text-link" href="/dashboard">Vissza az áttekintéshez</a>
    </p>
  </section>
</AppLayout>

<style>
  .planned {
    padding: 22px 24px;
    max-width: 720px;
  }

  .planned-list {
    margin: 18px 0 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .planned-list strong {
    color: var(--ink);
  }

  .planned-foot {
    margin-top: 22px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
</style>
