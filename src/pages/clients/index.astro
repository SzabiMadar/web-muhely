---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
---

<AppLayout title="Ügyfelek">
  <PageHeader
    eyebrow="Kapcsolatok"
    title="Ügyfelek"
    description="Ügyfélnyilvántartás kapcsolattartókkal és a hozzájuk tartozó projektekkel."
    ctaLabel="Új ügyfél"
    ctaHref="/clients/new"
  />

  <EmptyState
    title="Még nincs rögzített ügyfél."
    description="Az ügyfelek a W1 szeletben lesznek felvihetők. Egy ügyfélhez több projekt is tartozhat, az adatlap a kapcsolattartót, elérhetőségeket és a projektlistát mutatja majd."
    actionLabel="Ügyfél hozzáadása"
    actionHref="/clients/new"
  />
</AppLayout>
