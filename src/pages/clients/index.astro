---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import Icon from '../../components/Icon.astro';
import { listClients } from '../../lib/server/queries';

const supabase = Astro.locals.supabase!;
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const clients = await listClients(supabase, query || undefined);
---

<AppLayout title="Ügyfelek">
  <PageHeader
    eyebrow="Kapcsolatok"
    title="Ügyfelek"
    description="Ügyfélnyilvántartás kapcsolattartókkal és a hozzájuk tartozó projektekkel."
    ctaLabel="Új ügyfél"
    ctaHref="/clients/new"
  />

  {
    clients.length === 0 && !query ? (
      <EmptyState
        title="Még nincs rögzített ügyfél."
        description="Az első ügyfél felvételével indul a munka — hozzá több projekt is kapcsolható később."
        actionLabel="Első ügyfél hozzáadása"
        actionHref="/clients/new"
      />
    ) : (
      <section class="card client-list">
        <div class="panel-head">
          <h2>Ügyfélnyilvántartás</h2>
          <form method="GET" action="/clients" class="search" role="search">
            <label class="visually-hidden" for="client-search">Ügyfél keresése</label>
            <input
              id="client-search"
              type="search"
              name="q"
              value={query}
              placeholder="Keresés név vagy cég alapján…"
            />
          </form>
        </div>

        {clients.length === 0 && query ? (
          <p class="no-result">Nincs találat „{query}” keresésre. <a class="text-link" href="/clients">Szűrés törlése</a></p>
        ) : (
          <ul class="rows" role="list">
            {clients.map((client) => (
              <li>
                <a href={`/clients/${client.id}`} class="client-row">
                  <span class="client-avatar" aria-hidden="true">
                    {client.display_name.slice(0, 1).toUpperCase()}
                  </span>
                  <span class="client-main">
                    <strong>{client.display_name}</strong>
                    <span class="client-meta">
                      {[client.company_name, client.contact_name, client.email].filter(Boolean).join(' · ') || 'Nincs megadott kapcsolattartó'}
                    </span>
                  </span>
                  <span class="client-count">
                    {client.project_count} projekt
                    <Icon name="arrow" size={14} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }
</AppLayout>

<style>
  .client-list {
    padding: 22px 24px;
  }

  .search input {
    min-height: 40px;
    padding: 8px 13px;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    font: inherit;
    font-size: 13.5px;
    width: min(260px, 42vw);
    background: var(--surface);
    color: var(--ink);
  }

  .no-result {
    padding: 26px 4px 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .rows {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .client-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--border);
    transition: transform .12s ease;
  }

  .rows li:last-child .client-row {
    border-bottom: 0;
  }

  .client-row:hover {
    transform: translateX(4px);
  }

  .client-avatar {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--accent-soft);
    color: var(--accent-deep);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 15px;
    flex-shrink: 0;
  }

  .client-main {
    min-width: 0;
    flex: 1;
  }

  .client-main strong {
    display: block;
    font-size: 14.5px;
    font-weight: 700;
  }

  .client-meta {
    display: block;
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .client-count {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .client-count svg {
    color: var(--accent);
  }
</style>
