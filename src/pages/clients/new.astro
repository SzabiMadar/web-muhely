---
import { actions, isInputError } from 'astro:actions';
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FormField from '../../components/FormField.astro';

let formError: string | null = null;
let fieldErrors: Record<string, string[] | undefined> = {};
const values: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  for (const [key, value] of formData.entries()) {
    if (typeof value === 'string') values[key] = value;
  }
  const { data, error } = await Astro.callAction(actions.clients.create, formData);
  if (data?.clientId) {
    return Astro.redirect(`/clients/${data.clientId}`);
  }
  if (error) {
    if (isInputError(error)) {
      fieldErrors = error.fields as Record<string, string[] | undefined>;
      formError = 'Ellenőrizd a megjelölt mezőket.';
    } else {
      formError = error.message ?? 'A mentés nem sikerült — próbáld újra.';
    }
  }
}
---

<AppLayout title="Új ügyfél">
  <PageHeader
    eyebrow="Ügyfelek / Új ügyfél"
    title="Új ügyfél felvétele"
    description="Csak a név kötelező — a többi mező bármikor pótolható."
  />

  <section class="card client-form">
    {formError && <p class="form-error" role="alert">{formError}</p>}

    <form method="POST" novalidate>
      <div class="grid-2">
        <FormField
          name="display_name"
          label="Megjelenített név"
          required
          maxlength={200}
          value={values.display_name}
          error={fieldErrors.display_name?.[0]}
        />
        <FormField name="company_name" label="Cég / jogi név" maxlength={200} value={values.company_name} error={fieldErrors.company_name?.[0]} />
        <FormField name="contact_name" label="Kapcsolattartó" maxlength={200} value={values.contact_name} error={fieldErrors.contact_name?.[0]} />
        <FormField name="email" label="E-mail" type="email" autocomplete="off" value={values.email} error={fieldErrors.email?.[0]} />
        <FormField name="phone" label="Telefon" type="tel" autocomplete="off" maxlength={50} value={values.phone} error={fieldErrors.phone?.[0]} />
        <FormField name="address_text" label="Cím" maxlength={500} value={values.address_text} error={fieldErrors.address_text?.[0]} />
      </div>
      <FormField name="notes" label="Megjegyzés" textarea rows={3} value={values.notes} error={fieldErrors.notes?.[0]} />

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Ügyfél mentése</button>
        <a href="/clients" class="btn btn-ghost">Mégse</a>
      </div>
    </form>
  </section>
</AppLayout>

<style>
  .client-form {
    padding: 24px;
    max-width: 780px;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 20px;
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .form-error {
    background: var(--danger-soft);
    color: var(--danger);
    border-radius: var(--radius-control);
    padding: 11px 14px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  @media (max-width: 640px) {
    .grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
