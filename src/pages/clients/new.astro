---
import AppLayout from '../../layouts/AppLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusPill from '../../components/StatusPill.astro';
---

<AppLayout title="Új ügyfél">
  <PageHeader
    eyebrow="Ügyfelek / Új ügyfél"
    title="Új ügyfél felvétele"
    description="Az ügyfél-űrlap a W1 fejlesztési szeletben készül el, az adatbázis-kapcsolattal együtt."
  />

  <section class="card planned">
    <div class="panel-head">
      <h2>Így fog működni</h2>
      <StatusPill variant="warning" label="W1 szeletben érkezik" />
    </div>
    <ul class="planned-list">
      <li><strong>Kötelező:</strong> megjelenített név.</li>
      <li><strong>Opcionális:</strong> cég/jogi név, kapcsolattartó, e-mail, telefon, cím, megjegyzés.</li>
      <li><strong>Utána:</strong> az ügyfélhez közvetlenül projekt is létrehozható.</li>
    </ul>
    <p class="planned-foot">
      <a class="text-link" href="/clients">Vissza az ügyfelekhez</a>
    </p>
  </section>
</AppLayout>

<style>
  .planned {
    padding: 22px 24px;
    max-width: 720px;
  }

  .planned-list {
    margin: 18px 0 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .planned-list strong {
    color: var(--ink);
  }

  .planned-foot {
    margin-top: 22px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
</style>
