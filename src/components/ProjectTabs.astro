---
interface Props {
  projectId: string;
  active: 'overview' | 'workflow' | 'resources' | 'access' | 'handover';
}

const { projectId, active } = Astro.props;

const tabs = [
  { key: 'overview', label: 'Áttekintés', href: `/projects/${projectId}` },
  { key: 'workflow', label: 'Folyamat', href: `/projects/${projectId}/workflow` },
  { key: 'resources', label: 'Dosszié', href: `/projects/${projectId}/resources` },
  { key: 'access', label: 'Hozzáférések', href: `/projects/${projectId}/access` },
  { key: 'handover', label: 'Átadás', href: `/projects/${projectId}/handover` },
] as const;
---

<nav class="project-tabs" aria-label="Projekt szakaszok">
  <ul role="list">
    {
      tabs.map((tab) => (
        <li>
          <a
            href={tab.href}
            class:list={['tab', { active: tab.key === active }]}
            aria-current={tab.key === active ? 'page' : undefined}
          >
            {tab.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .project-tabs {
    margin-bottom: 24px;
  }

  .project-tabs ul {
    list-style: none;
    margin: 0;
    padding: 5px;
    display: inline-flex;
    gap: 4px;
    background: var(--surface-2);
    border-radius: 14px;
    max-width: 100%;
    overflow-x: auto;
  }

  .tab {
    display: inline-block;
    padding: 9px 16px;
    border-radius: 10px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
    transition: background-color .15s ease, color .15s ease;
  }

  .tab:hover {
    color: var(--ink);
  }

  .tab.active {
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-card);
  }
</style>
