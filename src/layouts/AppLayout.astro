---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Műhely Workspace — ügyfél- és projektmunkatér egy fejlesztőnek.' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Műhely Workspace</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ugrás a tartalomra</a>
    <div class="shell">
      <Sidebar currentPath={currentPath} />
      <main class="content" id="main-content">
        <div class="content-inner">
          <slot />
        </div>
      </main>
    </div>
    <MobileNav currentPath={currentPath} />
  </body>
</html>

<style>
  .shell {
    display: flex;
    min-height: 100vh;
  }

  .content {
    flex: 1;
    min-width: 0;
  }

  .content-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 40px 40px 64px;
  }

  @media (max-width: 860px) {
    .content-inner {
      padding: 24px 18px calc(96px + env(safe-area-inset-bottom));
    }
  }
</style>
